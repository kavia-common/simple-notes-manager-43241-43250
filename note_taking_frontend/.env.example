# Development environment variables for Slidev/Vite
# The dev server will use VITE_PORT if set, otherwise defaults to 3001.
# It binds to 0.0.0.0 and will not auto-open a browser.

# Common
VITE_NODE_ENV=development
VITE_PORT=3001
VITE_API_BASE=
VITE_BACKEND_URL=
VITE_FRONTEND_URL=
VITE_WS_URL=
VITE_TRUST_PROXY=true
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/healthz
VITE_FEATURE_FLAGS=markdownPreview
VITE_EXPERIMENTS_ENABLED=false
