# Frontend environment variables (prefix VITE_ to expose to client)
# Copy to .env and adjust as needed.

# Base URL for backend API (optional; if not set, app uses localStorage)
VITE_API_BASE=

# Alternative backend URL support
VITE_BACKEND_URL=

# App/site URLs (optional)
VITE_FRONTEND_URL=
VITE_WS_URL=

# Node env flags
VITE_NODE_ENV=development
VITE_NEXT_TELEMETRY_DISABLED=1

# Debugging and build
VITE_ENABLE_SOURCE_MAPS=false
VITE_LOG_LEVEL=info
VITE_PORT=3000
VITE_TRUST_PROXY=false

# Feature flags: JSON object or comma-separated list (e.g., markdownPreview)
# Examples:
# VITE_FEATURE_FLAGS={"markdownPreview":true}
# VITE_FEATURE_FLAGS=markdownPreview
VITE_FEATURE_FLAGS=
